{
  "expo": {
    "name": "LockBox Mobile",
    "slug": "lockbox-mobile",
    "owner": "toxicusvicious",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "lockbox-mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07091C"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.lockbox.vault"
    },
    "android": {
      "package": "com.lockbox.vault",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#07091C"
      }
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "abe5e064-6d04-42e6-b283-e5fd22ebf0d1"
      }
    }
  }
}
